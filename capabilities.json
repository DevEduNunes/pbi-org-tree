{
  "dataRoles": [
    { "name": "employeeId", "displayName": "Employee ID", "kind": "Grouping" },
    { "name": "employeeName", "displayName": "Employee name", "kind": "Grouping" },
    { "name": "managerId", "displayName": "Manager ID", "kind": "Grouping" },
    { "name": "managerName", "displayName": "Manager name", "kind": "Grouping" },
    { "name": "details", "displayName": "Card details (optional)", "kind": "Grouping" },
    { "name": "image", "displayName": "Image URL (optional)", "kind": "Grouping" },
    { "name": "color", "displayName": "Card color, e.g. #64C8C8 (optional)", "kind": "Grouping" }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            { "for": { "in": "employeeId" } },
            { "for": { "in": "employeeName" } },
            { "for": { "in": "managerId" } },
            { "for": { "in": "managerName" } },
            { "for": { "in": "details" } },
            { "for": { "in": "image" } },
            { "for": { "in": "color" } }
          ],
          "dataReductionAlgorithm": { "window": { "count": 30000 } }
        }
      }
    }
  ],
  "objects": {
    "layout": {
      "displayName": "Layout",
      "properties": {
        "initialDepth": { "displayName": "Initially expanded levels", "type": { "numeric": true } },
        "horizontalGap": { "displayName": "Horizontal gap", "type": { "numeric": true } },
        "verticalGap": { "displayName": "Vertical gap", "type": { "numeric": true } }
      }
    },
    "card": {
      "displayName": "Cards",
      "properties": {
        "width": { "displayName": "Width", "type": { "numeric": true } },
        "height": { "displayName": "Height", "type": { "numeric": true } },
        "cornerRadius": { "displayName": "Corner radius", "type": { "numeric": true } },
        "borderWidth": { "displayName": "Border width", "type": { "numeric": true } }
      }
    },
    "avatar": {
      "displayName": "Avatar",
      "properties": {
        "shape": {
          "displayName": "Shape",
          "type": {
            "enumeration": [
              { "displayName": "Circle", "value": "circle" },
              { "displayName": "Square", "value": "square" },
              { "displayName": "None", "value": "none" }
            ]
          }
        },
        "position": {
          "displayName": "Position",
          "type": {
            "enumeration": [
              { "displayName": "Left", "value": "left" },
              { "displayName": "Top", "value": "top" }
            ]
          }
        },
        "size": { "displayName": "Size", "type": { "numeric": true } }
      }
    },
    "text": {
      "displayName": "Text",
      "properties": {
        "titleSize": { "displayName": "Title size", "type": { "numeric": true } },
        "titleBold": { "displayName": "Title bold", "type": { "bool": true } },
        "detailSize": { "displayName": "Details size", "type": { "numeric": true } }
      }
    },
    "colors": {
      "displayName": "Colors",
      "properties": {
        "cardFill": { "displayName": "Card fill", "type": { "fill": { "solid": { "color": true } } } },
        "cardBorder": { "displayName": "Card border", "type": { "fill": { "solid": { "color": true } } } },
        "textColor": { "displayName": "Text", "type": { "fill": { "solid": { "color": true } } } }
      }
    },
    "connectors": {
      "displayName": "Connectors",
      "properties": {
        "color": { "displayName": "Color", "type": { "fill": { "solid": { "color": true } } } },
        "width": { "displayName": "Width", "type": { "numeric": true } },
        "shape": {
          "displayName": "Shape",
          "type": {
            "enumeration": [
              { "displayName": "Elbow", "value": "elbow" },
              { "displayName": "Curve", "value": "curve" },
              { "displayName": "Straight", "value": "straight" }
            ]
          }
        },
        "cornerRadius": { "displayName": "Elbow corner radius", "type": { "numeric": true } },
        "endMarker": { "displayName": "Dot at child end", "type": { "bool": true } }
      }
    }
  },
  "privileges": []
}
